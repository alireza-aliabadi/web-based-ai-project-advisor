# Server
APP_ENV=development
APP_PORT=8080
APP_JWT_SECRET=change-me-to-a-long-random-secret
APP_API_KEY=dev-api-key

# Database (required by docker compose — do not commit real secrets)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=architect
POSTGRES_PASSWORD=change-me
POSTGRES_DB=architect
# Optional for local runs; leave unset in Docker (compose builds it from POSTGRES_*)
# DATABASE_URL=postgres://architect:change-me@localhost:5432/architect?sslmode=disable

# Redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=knowledge

# LLM (OpenAI-compatible; works with OpenAI, Azure, or local proxies)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# External APIs
GITHUB_TOKEN=
HUGGINGFACE_TOKEN=
TAVILY_API_KEY=
